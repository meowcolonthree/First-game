[gd_scene format=3 uid="uid://hiiju0qoxds6"]

[sub_resource type="GDScript" id="GDScript_q87w4"]
resource_name = "teleport"
script/source = "extends Area2D

@onready var player: CharacterBody2D = %Player
@export var coords = Vector2(0,0)
@onready var timer: Timer = $Timer
@onready var label: Label = $\"Tp label\"
@export var label_text: String = \"\"

func _on_body_entered(_body: Node2D):
	player.position = coords
	label.text = label_text
	label.visible = true
	timer.start(5)

func _on_timer_timeout():
	label.visible = false
"

[node name="Area2D" type="Area2D" unique_id=1530988841]
collision_mask = 2
script = SubResource("GDScript_q87w4")

[node name="Timer" type="Timer" parent="." unique_id=444248223]

[connection signal="body_entered" from="." to="." method="_on_body_entered"]
[connection signal="timeout" from="Timer" to="." method="_on_timer_timeout"]
